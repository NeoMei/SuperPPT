  "workflowPolicy": {
    "conversation": {
      "silentEndToEndAllowed": false,
      "decisionMode": "one-content-specific-decision-at-a-time",
      "earlierStagesRevisable": true
    },
    "style": {
      "selectionMode": "single",
      "defaultAllowed": false,
      "catalog": "assets/styles/catalog.json",
      "previewMode": "compact-real-preview-grid",
      "selectionEvidence": "v2-current-revision-representative-slide-and-same-source-style-lock-sha",
      "legacyEvidence": "v1-read-migration-only-cannot-authorize-sample-plan",
      "publicationRecovery": "exact-idempotent-v1-to-v2-migration-and-checkpoint-replay; stale-retirement-requires-project-old-revision-child-descriptor-and-immutable-snapshot-byte-binding; conflicts-byte-exact-fail-closed"
    },
    "generation": {
      "executor": "agent-invokes-resolved-ai-image-to-ppt-skill",
      "cliExecutesDependency": false,
      "scheduling": "serial",
      "providerSelectedBy": "ai-image-to-ppt-host-routing"
    },
    "delivery": {
      "reviewRequired": true,
      "genericApprovalAllowed": false,
      "reviewActions": ["edit-page", "return-upstream", "confirm-delivery"]
    },
    "editing": {
      "artifactKind": "complete-local-pptx",
      "localPptxLinksPerResponse": 1,
      "previewAndEditor": "wps-or-powerpoint",
      "pageResolution": "current-reconciled-topology",
      "authorization": {
        "action": "complete-deck-review-edit-page",
        "binding": "exact-current-revision-sha256-stable-slide-id",
        "consumption": "one-time-atomic-before-candidate-session-creation",
        "failure": "missing-wrong-slide-stale-replay-fail-closed-zero-residue"
      },
      "manual": {
        "revisionBinding": "resolver-revision-id-must-still-be-current",
        "waitForUserText": "已保存并关闭",
        "internalSignal": "saved-and-closed",
        "acceptsSavedOnly": false,
        "adoption": "stable-read-validate-metadata-only-pointer-move",
        "topology": "reconcile-move-insert-delete-with-stable-slide-ids"
      },
      "agent": {
        "waitForUserText": "确认",
        "confirmationBinding": "exact-presented-sha256",
        "pointerBeforeConfirmation": "unchanged"
      },
      "rollback": "pointer-only-no-pptx-write"
    },
    "jobInputs": {
      "styleSample": {
        "styleLockState": "provisional",
        "approvedSample": "must-be-null",
        "required": ["exact-recipe-and-hash", "reference-snapshots", "representative-page-spec-and-prompt", "one-call-authorization"]
      },
      "deckAndPageRegeneration": {
        "styleLockState": "approved",
        "approvedSample": "authenticated-non-null",
        "required": ["exact-recipe-and-hash", "reference-snapshots", "page-specific-spec-and-prompt", "generation-authorization"]
      }
    },
    "changeInvalidation": {
      "style": ["style-sample-generation", "style-sample", "generation-authorization", "deck-review", "formal-delivery", "acceptance-evidence"]
    }
  }
}
